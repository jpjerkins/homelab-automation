services:
  web:
    # Container name
    container_name: jerkins-website

    # Never check for newer images online - they're not out there
    pull_policy: never

    # Port mapping (host:container)
    ports:
      - "8084:80"

    # Restart policy
    restart: unless-stopped

    # Image name with date tag
    image: jerkins-website:latest

    # Environment variables (if needed in the future)
    environment:
      - CONTENT_FOLDER=content
      - NODE_ENV=production

    # Health check
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:80"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

    # Networks
    networks:
    - ghost-home

    # Labels for better organization
    labels:
      - "com.jerkins.description=Jerkins Family Website"
      - "com.jerkins.version=1.0"

networks:
  ghost-home:
    external: true
